{
  "name": "tally-desktop",
  "productName": "Tally",
  "version": "1.0.0",
  "private": true,
  "description": "Tally for Windows: the app's web build in an Electron window, with SQLite in the main process.",
  "main": "main.js",
  "author": "Alisher Shayakhmetov",
  "license": "MIT",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "start": "electron .",
    "e2e": "node e2e/run.mjs",
    "dist": "npm run build:web && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "electron": "^44.10.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.0"
  },
  "build": {
    "appId": "com.alishershayakhmetov.taskcounter.desktop",
    "productName": "Tally",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "web/**/*",
      "build/icon.png",
      "!node_modules/better-sqlite3/{deps,src,build}/**",
      "!node_modules/better-sqlite3/prebuilds/!(win32-x64.node)"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/prebuilds/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Tally-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Tally-${version}-portable.${ext}"
    }
  }
}
